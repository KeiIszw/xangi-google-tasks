# G2 アプリが送る Bearer token（必須）。例: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
GTASKS_DEVICE_TOKEN=
# gog の対象アカウントと file キーリングのパスワード（必須）
GOG_ACCOUNT=
GOG_KEYRING_PASSWORD=
# gog の場所（PATH にない場合）
# GOG_BIN=/home/user/bin/gog
# 音声でタスクを追加する場合の Groq API キー
GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GTASKS_STT_LANG=ja
